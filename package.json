{
  "name": "@lekoala/web-utils",
  "version": "0.2.0",
  "description": "Small zero-dependency browser utilities",
  "type": "module",
  "license": "MIT",
  "author": "LeKoala",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekoala/web-utils.git"
  },
  "homepage": "https://github.com/lekoala/web-utils",
  "bugs": "https://github.com/lekoala/web-utils/issues",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./array": {
      "types": "./types/array.d.ts",
      "import": "./src/array.js"
    },
    "./string": {
      "types": "./types/string.d.ts",
      "import": "./src/string.js"
    },
    "./value": {
      "types": "./types/value.d.ts",
      "import": "./src/value.js"
    },
    "./timing": {
      "types": "./types/timing.d.ts",
      "import": "./src/timing.js"
    },
    "./url": {
      "types": "./types/url.d.ts",
      "import": "./src/url.js"
    },
    "./form": {
      "types": "./types/form.d.ts",
      "import": "./src/form.js"
    },
    "./dom": {
      "types": "./types/dom.d.ts",
      "import": "./src/dom.js"
    },
    "./dom/attrs": {
      "types": "./types/dom/attrs.d.ts",
      "import": "./src/dom/attrs.js"
    },
    "./dom/classes": {
      "types": "./types/dom/classes.d.ts",
      "import": "./src/dom/classes.js"
    },
    "./dom/create": {
      "types": "./types/dom/create.d.ts",
      "import": "./src/dom/create.js"
    },
    "./dom/events": {
      "types": "./types/dom/events.d.ts",
      "import": "./src/dom/events.js"
    },
    "./dom/html": {
      "types": "./types/dom/html.d.ts",
      "import": "./src/dom/html.js"
    },
    "./dom/query": {
      "types": "./types/dom/query.d.ts",
      "import": "./src/dom/query.js"
    },
    "./dom/ready": {
      "types": "./types/dom/ready.d.ts",
      "import": "./src/dom/ready.js"
    },
    "./custom-elements": {
      "types": "./types/custom-elements.d.ts",
      "import": "./src/custom-elements.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p jsconfig.json",
    "types": "tsc -p tsconfig.types.json",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run types",
    "check": "bun run verify",
    "prepack": "bun run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@happy-dom/global-registrator": "^20.14.0",
    "typescript": "^7.0.2"
  }
}
